# ==============================================================================
# Pterodactyl Panel v1.15.2 — Node.js + Java Edition (SOURAJITVFX)
# Lightweight, Non-Systemd & Docker VPS Compatible Configuration
# ==============================================================================

# Public URL where the panel is accessed
APP_URL="http://localhost:3000"

# Panel Application Settings
APP_NAME="Pterodactyl"
APP_VERSION="1.15.2-node"
PORT=3000
NODE_ENV=production
APP_KEY="CHANGE_ME_GENERATE_32_BYTE_HEX_SECRET"
JWT_SECRET="CHANGE_ME_GENERATE_32_BYTE_JWT_SECRET"
SESSION_COOKIE_NAME="pterodactyl_session"
SESSION_TTL_HOURS=72
SINGLE_NODE_MODE=true

# Database Configuration (Production default: mysql / MariaDB)
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=pterodactyl
DB_USERNAME=pterodactyl
DB_PASSWORD=CHANGE_ME_STRONG_DB_PASSWORD
DB_POOL_LIMIT=10

# Optional development fallback when MySQL is unavailable locally
ALLOW_SQLITE_DEV_FALLBACK=false
SQLITE_PATH=./storage/database.sqlite

# Storage & Runtime Paths
STORAGE_DIR=./storage
SERVERS_DIR=./storage/servers
BACKUPS_DIR=./storage/backups
LOGS_DIR=./storage/logs
JAVA_RUNTIME_DIR=./runtime/java
DEFAULT_JAVA_PATH=

# Single Local Node Defaults
LOCAL_NODE_NAME="Local Node"
LOCAL_NODE_FQDN="127.0.0.1"
LOCAL_NODE_MEMORY_MB=8192
LOCAL_NODE_DISK_MB=51200

