<%- include('partials/header', { title: 'Settings', activeNav: 'settings', contentHeader: '<h1>Panel Settings<small>Configure Pterodactyl to your liking.</small></h1><ol class="breadcrumb"><li><a href="/admin">Admin</a></li><li class="active">Settings</li></ol>' }) %>

<div class="row">
    <div class="col-xs-12">
        <div class="box">
            <div class="box-header with-border">
                <h3 class="box-title">Panel Settings</h3>
            </div>
            <form action="/admin/settings" method="POST">
                <input type="hidden" name="_csrf" value="<%= csrfToken %>">
                <div class="box-body">
                    <div class="row">
                        <div class="form-group col-md-4">
                            <label class="control-label">Company Name</label>
                            <div>
                                <input type="text" class="form-control" name="app:name" value="<%= settings['settings:app:name'] || 'Pterodactyl' %>" />
                                <p class="text-muted"><small>This is the name that is used throughout the panel.</small></p>
                            </div>
                        </div>
                        <div class="form-group col-md-4">
                            <label class="control-label">Require 2-Factor Authentication</label>
                            <div>
                                <% const level = Number(settings['settings:pterodactyl:auth:2fa_required'] || 0); %>
                                <div class="btn-group" data-toggle="buttons">
                                    <label class="btn btn-primary <%= level === 0 ? 'active' : '' %>">
                                        <input type="radio" name="pterodactyl:auth:2fa_required" autocomplete="off" value="0" <%= level === 0 ? 'checked' : '' %>> Not Required
                                    </label>
                                    <label class="btn btn-primary <%= level === 1 ? 'active' : '' %>">
                                        <input type="radio" name="pterodactyl:auth:2fa_required" autocomplete="off" value="1" <%= level === 1 ? 'checked' : '' %>> Admin Only
                                    </label>
                                    <label class="btn btn-primary <%= level === 2 ? 'active' : '' %>">
                                        <input type="radio" name="pterodactyl:auth:2fa_required" autocomplete="off" value="2" <%= level === 2 ? 'checked' : '' %>> All Users
                                    </label>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
                <div class="box-footer">
                    <button type="submit" class="btn btn-sm btn-primary pull-right">Save</button>
                </div>
            </form>
        </div>
    </div>
</div>

<%- include('partials/footer') %>
